# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# JWT Secret (required — server fails to sign/verify tokens if missing)
JWT_SECRET="generate_a_strong_random_string_here"

# AI Provider: "dummy" (development baseline) or "configured" (OpenAI-compatible)
AI_PROVIDER="dummy"
# Only required when AI_PROVIDER=configured
AI_API_KEY="sk-your_provider_api_key"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS=30000

# Super Admin Seed Credentials
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@healthwise.com"
SUPER_ADMIN_PASSWORD="YourSecurePassword123!"

# Server Settings
PORT=5000
FRONTEND_URL="http://localhost:5173"

# Environment
NODE_ENV="development"
